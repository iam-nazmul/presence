# Copy to .env and fill in. Nothing here is required to run `presence chat`
# except a running Ollama.

# --- model ------------------------------------------------------------------
# ollama | openai | openrouter -- all three speak the same wire format,
# so switching is this one line plus a model name.
PROVIDER=ollama
MODEL_MAIN=qwen3.5:9b
MODEL_FAST=qwen3.5:4b
NUM_CTX=32768
TEMPERATURE=0.3
MAX_TURNS=8

# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- surfaces ---------------------------------------------------------------
# From @BotFather. Without it, only the terminal surface runs.
TELEGRAM_BOT_TOKEN=

# --- whatsapp (a personal account, linked as a device) -----------------------
# Meta's Cloud API only talks to WhatsApp Business numbers. To send and receive
# on your own number the agent links as a device instead -- the same thing
# web.whatsapp.com does. Scan the QR once and it stays linked.
#
#   uv sync --extra whatsapp
#   brew install libmagic     # macOS (apt install libmagic1 on Debian/Ubuntu)
#   uv run presence whatsapp  # prints the QR: WhatsApp → Linked devices
#
# This is not an API Meta publishes and automating a personal account is against
# the WhatsApp ToS -- numbers do get banned for it. Use a spare number.
WHATSAPP_ENABLED=false

# Who the agent is allowed to answer, comma separated, country code first.
# LEAVE THIS SET. Empty means it replies to everyone who has your number.
# WHATSAPP_ALLOWED=8801700000000,8801800000000

# Group chats are ignored unless this is on.
WHATSAPP_GROUPS=false

# Answer in your own "Message yourself" chat -- the easiest way to test without
# a second phone. Replies the agent sends there are skipped, not re-answered.
WHATSAPP_SELF_CHAT=true

# Blue ticks on messages the agent has picked up.
WHATSAPP_MARK_READ=true

# The linked-device credential. It can send as you until you unlink it from the
# phone, so keep it out of git and off shared machines.
# WHATSAPP_SESSION=whatsapp-session.db

# Pair by typing an 8-character code on the phone instead of scanning the QR.
# Your own number, country code first, no +.
# WHATSAPP_PAIR_PHONE=8801700000000

# --- identity ---------------------------------------------------------------
# Identities treated as the owner at startup, comma separated:
#   OWNER_IDENTITIES=cli:local,telegram:12345,whatsapp:8801700000000
# A WhatsApp identity is the plain number, country code first and no +.
# cli:local is seeded so the terminal is always you. Link other surfaces at
# runtime with /link instead of hard-coding ids here.
OWNER_IDENTITIES=cli:local
OWNER_NAME=you

# Where proactive messages go when the agent was not asked anything.
# Leave empty to use the most recently active conversation.
# PREFERRED_SURFACE=telegram

# --- tools ------------------------------------------------------------------
# Optional. Without it, web_search falls back to DuckDuckGo HTML.
# EXA_API_KEY=

# --- workspace ---------------------------------------------------------------
# Where the agent may create files and run commands. Everything the file and
# shell tools touch has to sit under this, so "make a Django project on my
# Desktop" works with the default; point it at one projects folder for a
# tighter blast radius.
#
# Only the OWNER gets these tools -- a stranger messaging your WhatsApp is never
# even told they exist. That means your own number must be listed in
# OWNER_IDENTITIES above, or you will be a guest on your own phone.
# WORKSPACE_ROOT=/Users/you

# Steps the agent may take in one turn before it gives up. Real work is
# multi-step and each confirmation spends one, so keep this generous.
MAX_TURNS=16
